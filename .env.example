# Copier ce modele dans .env puis renseigner les valeurs vides.

# Application locale — valeurs de production distinctes dans Vercel/GitHub.
ENVIRONMENT=development
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./trackr.db
TRACKR_SEASON=2027

# Securite — generer des cles locales ; ne pas remplacer les cles de production.
SECRET_KEY=
ENCRYPTION_KEY=

# Email — SMTP avec STARTTLS sur le port 587. SMTP_PASS_APP contient le mot de passe applicatif.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS_APP=
SMTP_FROM=
ADMIN_EMAIL=

# Connexion personnelle Notion — integration publique, deux valeurs a renseigner ensemble.
# Callback local : http://localhost:8000/notion/callback
# Callback production : https://trackr-alerts.vercel.app/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_VERSION=2025-09-03

# Anciens scrapers CSV/Notion — toujours utilises par le workflow historique.
# FROM_ADDR est utilise par les anciens scripts, SMTP_FROM par la plateforme.
# TO_ADDRS est facultatif si email.csv contient deja les destinataires.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
TODO_DATA_SOURCE_ID=
FROM_ADDR=
TO_ADDRS=
OFF_CYCLE_EMAIL_START_TERM=2027 Q1 Start
HK_OFF_CYCLE_EMAIL_START_TERM=2027 Q1 Start

# Deploiement — facultatif en local ; valeurs GitHub Actions/Vercel distinctes.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Tests PostgreSQL — facultatif ; schemas audit_test_* temporaires.
TEST_DATABASE_URL=

# Options ponctuelles des anciens scrapers (ne pas definir globalement) :
# FORCE_EMAIL_ALL=1 : renvoyer les offres existantes.
# OUTPUT_FILE=... : chemin CSV propre au script lance.
# VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA et GITHUB_SHA sont fournis par la plateforme.
# Pour la production, DATABASE_URL doit pointer vers PostgreSQL et APP_URL utiliser HTTPS.

# Personal Notion stays paused until OAuth and the worker are enabled together.
NOTION_SYNC_ENABLED=false
# Platform accounts never receive legacy email; migrate recipients with the CLI.
LEGACY_EMAIL_ENABLED=true
# Optional legacy Notion TODO synchronization.
LEGACY_TODO_ENABLED=false
