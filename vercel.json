{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{audit,tools,scripts,tests,.trackr-backups,.github}/**"
    }
  }
}
